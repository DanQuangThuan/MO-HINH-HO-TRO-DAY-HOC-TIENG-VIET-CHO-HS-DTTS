function saveAssess(){let sid=document.getElementById('asStudent').value;if(!sid)return alert('Chọn học sinh');let scores=[],desc=[];for(let i=1;i<=5;i++){let v=+document.getElementById('sc'+i).value;if(!v)return alert('Chấm đủ 5 tiêu chí');scores.push(v);desc.push(document.getElementById('desc'+i).value||'Tiêu chí '+i)}db.assess.push({id:uid(),sid,date:document.getElementById('asDate').value,round:document.getElementById('asRound').value,note:document.getElementById('asNote').value,skill,scores,desc,avg:scores.reduce((a,b)=>a+b,0)/5});save();alert('Đã lưu điểm '+skill);render()}
function assessTable(){return db.assess.length?`<div class="tablewrap"><table><tr><th>Ngày</th><th>Học sinh</th><th>Kỹ năng</th><th>Đợt</th><th>Điểm TB</th><th></th></tr>${db.assess.slice().reverse().map(a=>`<tr><td>${a.date}</td><td>${E(sname(a.sid))}</td><td>${a.skill}</td><td>${E(a.round)}</td><td>${a.avg.toFixed(2)}</td><td><button class="btn danger" onclick="delAssess('${a.id}')">Xóa</button></td></tr>`).join('')}</table></div>`:'<div class="empty">Chưa có đánh giá.</div>'}function delAssess(id){if(confirm('Xóa lượt đánh giá?')){db.assess=db.assess.filter(a=>a.id!==id);save();render()}}
function solutionPage(){return `<div class="panel"><h2>Sáu nhóm giải pháp trong hồ sơ sản phẩm</h2><p class="muted">Lựa chọn linh hoạt theo nhu cầu thực tế, không nhất thiết triển khai đồng loạt.</p><div class="grid six">${solutions.map((s,i)=>`<div class="tile"><b>${s[0]}</b><p>${s[1]}</p><button class="btn" onclick="go('plans');setTimeout(()=>planForm(null,${i}),0)">Chọn cho kế hoạch</button></div>`).join('')}</div></div>`}
function plans(){return `<div class="panel"><div class="toolbar"><h2 style="margin-right:auto">Kế hoạch hỗ trợ cá nhân</h2><button class="btn primary" onclick="planForm()">+ Tạo kế hoạch</button></div>${db.plans.length?`<div class="tablewrap"><table><tr><th>Học sinh</th><th>Nhu cầu</th><th>Giải pháp</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr>${db.plans.map(p=>`<tr><td>${E(sname(p.sid))}</td><td>${E(p.need)}</td><td>${solutions[p.sol][0]}</td><td>${p.start} – ${p.end}</td><td>${E(p.status)}</td><td><button class="btn" onclick="planForm('${p.id}')">Sửa</button> <button class="btn danger" onclick="delPlan('${p.id}')">Xóa</button></td></tr>`).join('')}</table></div>`:'<div class="empty">Chưa có kế hoạch hỗ trợ.</div>'}</div>`}
function planForm(pid=null,sol=null){if(!db.students.length)return alert('Thêm học sinh trước');let p=db.plans.find(x=>x.id===pid);modal('Lập kế hoạch hỗ trợ',`<div class="form"><div class="field"><label>Học sinh</label><select id="ps">${db.students.map(s=>`<option value="${s.id}" ${p?.sid===s.id?'selected':''}>${E(s.name)}</option>`).join('')}</select></div><div class="field"><label>Giải pháp</label><select id="pl">${solutions.map((s,i)=>`<option value="${i}" ${(p?.sol??sol)===i?'selected':''}>${s[0]}</option>`).join('')}</select></div><div class="field full"><label>Nhu cầu/khó khăn ưu tiên</label><textarea id="pn">${E(p?.need||'')}</textarea></div><div class="field full"><label>Mục tiêu cụ thể</label><textarea id="pg">${E(p?.goal||'')}</textarea></div><div class="field full"><label>Hoạt động và học liệu</label><textarea id="pa">${E(p?.activity||'')}</textarea></div><div class="field"><label>Bắt đầu</label><input id="pstart" type="date" value="${p?.start||''}"></div><div class="field"><label>Kết thúc</label><input id="pend" type="date" value="${p?.end||''}"></div><div class="field"><label>Người thực hiện</label><input id="powner" value="${E(p?.owner||'')}"></div><div class="field"><label>Trạng thái</label><select id="pstatus">${['Chưa thực hiện','Đang thực hiện','Hoàn thành','Cần điều chỉnh'].map(x=>`<option ${p?.status===x?'selected':''}>${x}</option>`).join('')}</select></div></div>`,()=>{let o={sid:document.getElementById('ps').value,sol:+document.getElementById('pl').value,need:document.getElementById('pn').value,goal:document.getElementById('pg').value,activity:document.getElementById('pa').value,start:document.getElementById('pstart').value,end:document.getElementById('pend').value,owner:document.getElementById('powner').value,status:document.getElementById('pstatus').value};if(!o.need.trim()||!o.goal.trim())return alert('Nhập nhu cầu và mục tiêu');if(p)Object.assign(p,o);else db.plans.push({id:uid(),...o});save();closeM();render()})}
function delPlan(id){if(confirm('Xóa kế hoạch?')){db.plans=db.plans.filter(p=>p.id!==id);save();render()}}
function logs(){return `<div class="panel"><h2>Ghi nhận tiến độ hỗ trợ</h2><div class="form"><div class="field"><label>Học sinh</label><select id="ls"><option value="">Chọn học sinh</option>${db.students.map(s=>`<option value="${s.id}">${E(s.name)}</option>`).join('')}</select></div><div class="field"><label>Ngày</label><input id="ld" type="date" value="${new Date().toISOString().slice(0,10)}"></div><div class="field"><label>Kỹ năng</label><select id="lk">${skills.map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label>Tiến độ</label><select id="ll">${['Tiến bộ rõ','Có tiến bộ','Chưa thay đổi rõ','Cần hỗ trợ thêm'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field full"><label>Biểu hiện/minh chứng quan sát</label><textarea id="le"></textarea></div><div class="field full"><label>Điều chỉnh tiếp theo</label><textarea id="ln"></textarea></div></div><button class="btn primary" onclick="saveLog()">Lưu ghi nhận</button></div><div class="panel"><h2>Lịch sử theo dõi</h2>${db.logs.length?`<div class="tablewrap"><table><tr><th>Ngày</th><th>Học sinh</th><th>Kỹ năng</th><th>Mức tiến độ</th><th>Minh chứng</th><th>Điều chỉnh</th></tr>${db.logs.slice().reverse().map(x=>`<tr><td>${x.date}</td><td>${E(sname(x.sid))}</td><td>${x.skill}</td><td>${E(x.level)}</td><td>${E(x.evidence)}</td><td>${E(x.next)}</td></tr>`).join('')}</table></div>`:'<div class="empty">Chưa có ghi nhận.</div>'}</div>`}
function saveLog(){let sid=document.getElementById('ls').value,evidence=document.getElementById('le').value.trim();if(!sid||!evidence)return alert('Chọn học sinh và nhập minh chứng');db.logs.push({id:uid(),sid,date:document.getElementById('ld').value,skill:document.getElementById('lk').value,level:document.getElementById('ll').value,evidence,next:document.getElementById('ln').value});save();render()}
function reports(){let averages=skills.map(sk=>{let a=db.assess.filter(x=>x.skill===sk);return [sk,a.length,a.length?a.reduce((s,x)=>s+x.avg,0)/a.length:0]});return `<div class="panel"><h2>Thống kê dữ liệu</h2><div class="grid stats">${[['Học sinh',db.students.length],['Lượt đánh giá',db.assess.length],['Kế hoạch',db.plans.length],['Theo dõi',db.logs.length]].map(x=>`<div class="stat"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join('')}</div><h3>Điểm trung bình theo kỹ năng</h3>${averages.map(a=>`<p><b>${a[0]}</b> <span class="muted">${a[1]?'('+a[1]+' lượt)':'(chưa có dữ liệu)'}</span> · ${a[1]?a[2].toFixed(2)+'/5':'—'}</p><div class="bar"><i style="width:${a[1]?a[2]*20:0}%"></i></div>`).join('')}<div class="notice">Chỉ so sánh trước–sau khi cùng học sinh, cùng tiêu chí và cách tính. Thống kê không tự chứng minh hiệu quả can thiệp.</div></div><div class="panel"><h2>Đối chiếu trước – sau theo học sinh</h2><div class="toolbar"><select id="rs" onchange="compare()"><option value="">Chọn học sinh</option>${db.students.map(s=>`<option value="${s.id}">${E(s.name)}</option>`).join('')}</select><select id="rk" onchange="compare()">${skills.map(x=>`<option>${x}</option>`).join('')}</select></div><div id="comp" class="empty">Chọn học sinh và kỹ năng.</div></div><button class="btn primary" onclick="csv()">Xuất bảng đánh giá CSV</button>`}
function compare(){let sid=document.getElementById('rs').value,sk=document.getElementById('rk').value;if(!sid)return;let a=db.assess.filter(x=>x.sid===sid&&x.skill===sk).sort((x,y)=>x.date.localeCompare(y.date)),el=document.getElementById('comp');el.innerHTML=a.length?`<div class="grid two"><div class="stat"><span>Lượt đầu</span><strong>${a[0].avg.toFixed(2)}</strong><small>${a[0].date}</small></div><div class="stat"><span>Lượt gần nhất</span><strong>${a.at(-1).avg.toFixed(2)}</strong><small>${a.at(-1).date}</small></div></div><p>Chênh lệch: <b>${(a.at(-1).avg-a[0].avg)>0?'+':''}${(a.at(-1).avg-a[0].avg).toFixed(2)}</b></p>${a.map(x=>`<p>${x.date} · ${x.round}: <b>${x.avg.toFixed(2)}</b></p>`).join('')}`:'Chưa có dữ liệu'}
function backupPage(){return `<div class="panel"><h2>Sao lưu và khôi phục</h2><p>Xuất dữ liệu thành JSON để cất giữ. Khôi phục sẽ thay thế dữ liệu hiện có.</p><button class="btn primary" onclick="backup()">Tải bản sao lưu JSON</button> <button class="btn" onclick="document.getElementById('restoreFile').click()">Khôi phục JSON</button> <button class="btn" onclick="csv()">Xuất CSV đánh giá</button></div><div class="panel"><h2>Lưu ý kỹ thuật và bảo mật</h2><ul><li>Website tĩnh chạy trên GitHub Pages; dữ liệu lưu bằng localStorage trên trình duyệt.</li><li>Không có đăng nhập, phân quyền hoặc đồng bộ nhiều thiết bị.</li><li>Repository Public/website Pages công khai; tuyệt đối không đưa dữ liệu định danh học sinh lên GitHub.</li><li>Chỉ nhập dữ liệu học sinh thật khi có thẩm quyền và biện pháp bảo vệ phù hợp; hạn chế chia sẻ bản sao lưu.</li><li>Thang 1–5 là công cụ hỗ trợ nghiên cứu, không thay thế quy định đánh giá hiện hành.</li></ul></div><div class="panel"><h2>Xóa dữ liệu</h2><button class="btn danger" onclick="clearData()">Xóa toàn bộ dữ liệu trên trình duyệt này</button></div>`}
function backup(){let b=new Blob([JSON.stringify({app:'PHHG-CSSV-2614',version:2,data:db},null,2)],{type:'application/json'});download(b,'sao-luu-mo-hinh-tieng-viet.json')}
function download(b,n){let a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=n;a.click();URL.revokeObjectURL(a.href)}
document.getElementById('restoreFile').onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result),d=x.data||x;if(!Array.isArray(d.students)||!Array.isArray(d.classes))throw 0;if(confirm('Thay thế toàn bộ dữ liệu hiện tại?')){db={classes:d.classes||[],students:d.students||[],assess:d.assess||[],plans:d.plans||[],logs:d.logs||[]};save();render();alert('Đã khôi phục')}}catch(z){alert('Tệp không đúng định dạng')}};r.readAsText(f);e.target.value=''}
function csv(){let rows=[['Ngày','Học sinh','Lớp','Kỹ năng','Đợt','TC1','TC2','TC3','TC4','TC5','Điểm TB','Ghi chú'],...db.assess.map(a=>[a.date,sname(a.sid),cname(db.students.find(s=>s.id===a.sid)?.classId),a.skill,a.round,...a.scores,a.avg.toFixed(2),a.note])];download(new Blob(['\\ufeff'+rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\\r\\n')],{type:'text/csv;charset=utf-8'}),'bang-danh-gia.csv')}
