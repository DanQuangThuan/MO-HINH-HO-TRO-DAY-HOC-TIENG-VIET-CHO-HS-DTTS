function reportsPage(){let total=db.students.length,bySkill=skills.map(sk=>{let a=db.assessments.filter(x=>x.skill===sk);return {sk,n:a.length,avg:a.length?a.reduce((s,x)=>s+x.avg,0)/a.length:0}});return `<div class="panel"><h2>Tổng hợp dữ liệu</h2><div class="grid stats"><div class="stat"><span>Học sinh</span><strong>${total}</strong></div><div class="stat"><span>Đánh giá</span><strong>${db.assessments.length}</strong></div><div class="stat"><span>Kế hoạch</span><strong>${db.plans.length}</strong></div><div class="stat"><span>Ghi nhận tiến độ</span><strong>${db.logs.length}</strong></div></div><h3>Điểm trung bình theo kỹ năng (các lượt đánh giá đã lưu)</h3>${bySkill.map(x=>`<div style="margin:13px 0"><div style="display:flex;justify-content:space-between"><b>${x.sk}</b><span>${x.n?x.avg.toFixed(2):'Chưa có dữ liệu'} ${x.n?' / 5':''}</span></div><div class="bar"><i style="width:${x.n?x.avg/5*100:0}%"></i></div></div>`).join('')}<div class="notice">Các chỉ số trên là thống kê mô tả từ dữ liệu đã nhập, không tự chứng minh hiệu quả can thiệp. Chỉ so sánh trước–sau khi cùng học sinh, cùng tiêu chí và cách tính.</div></div><div class="panel"><h2>Đối chiếu trước – sau theo học sinh và kỹ năng</h2><div class="toolbar"><select id="reportStudent" onchange="renderComparison()"><option value="">Chọn học sinh</option>${db.students.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('')}</select><select id="reportSkill" onchange="renderComparison()">${skills.map(s=>`<option>${s}</option>`).join('')}</select></div><div id="comparison"><div class="empty">Chọn học sinh và kỹ năng để xem kết quả.</div></div></div><div class="actions"><button class="btn primary" onclick="exportCSV()">Xuất bảng đánh giá CSV</button><button class="btn" onclick="exportJSON()">Tải bản sao lưu JSON</button></div>`}
