function deletePlan(pid){if(confirm('Xóa kế hoạch này?')){db.plans=db.plans.filter(p=>p.id!==pid);save();render()}}
function progressPage(){return `<div class="panel"><h2>Ghi nhận tiến độ hỗ trợ</h2><div class="formgrid"><div class="field"><label>Học sinh</label><select id="logStudent"><option value="">Chọn học sinh</option>${db.students.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('')}</select></div><div class="field"><label>Ngày ghi nhận</label><input type="date" id="logDate" value="${new Date().toISOString().slice(0,10)}"></div><div class="field"><label>Kỹ năng</label><select id="logSkill">${skills.map(s=>`<option>${s}</option>`).join('')}</select></div><div class="field"><label>Mức độ tiến bộ</label><select id="logLevel"><option>Tiến bộ rõ</option><option>Có tiến bộ</option><option>Chưa thay đổi rõ</option><option>Cần hỗ trợ thêm</option></select></div><div class="field full"><label>Biểu hiện/ minh chứng quan sát được</label><textarea id="logEvidence" placeholder="Ghi nhận cụ thể, tránh nhận xét chung chung..."></textarea></div><div class="field full"><label>Điều chỉnh tiếp theo</label><textarea id="logNext"></textarea></div></div><button class="btn primary" onclick="saveLog()">Lưu ghi nhận</button></div><div class="panel"><h2>Lịch sử theo dõi</h2>${logsTable()}</div>`}
