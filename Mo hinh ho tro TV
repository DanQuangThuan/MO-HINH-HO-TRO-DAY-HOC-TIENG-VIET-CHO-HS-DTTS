function plansTable(){if(!db.plans.length)return '<div class="empty">Chưa có kế hoạch hỗ trợ. Tạo kế hoạch từ kết quả đánh giá hoặc chọn một giải pháp.</div>';return `<div class="tablewrap"><table><thead><tr><th>Học sinh</th><th>Nhu cầu ưu tiên</th><th>Giải pháp</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody>${db.plans.map(p=>`<tr><td>${esc(stuName(p.studentId))}</td><td>${esc(p.need)}</td><td>${solutions[p.solution]?.[0]||'—'}</td><td>${esc(p.start||'')} – ${esc(p.end||'')}</td><td><span class="tag ${p.status==='Hoàn thành'?'green':'amber'}">${esc(p.status)}</span></td><td><button class="btn" onclick="editPlan('${p.id}')">Sửa</button> <button class="btn danger" onclick="deletePlan('${p.id}')">Xóa</button></td></tr>`).join('')}</tbody></table></div>`}
