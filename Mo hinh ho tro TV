function home(){return `<div class="grid stats">${[['Học sinh',db.students.length],['Lớp học',db.classes.length],['Lượt đánh giá',db.assess.length],['Kế hoạch hỗ trợ',db.plans.length]].map(x=>`<div class="stat"><span>${x[0]}</span><strong>${x[1]}</strong></div>`).join('')}</div><div class="grid two"><div class="panel"><h2>Quy trình vận hành 5 bước</h2>${['Đánh giá năng lực Tiếng Việt','Xác định khó khăn và nhu cầu hỗ trợ','Lựa chọn và triển khai giải pháp','Đánh giá kết quả và điều chỉnh','Tiếp tục phát triển năng lực Tiếng Việt'].map((x,i)=>`<div class="step"><b>${i+1}. ${x}</b><div class="small muted">${['Ghi nhận bốn kỹ năng theo tiêu chí lớp 1–5.','Phân tích điểm, quan sát và điều kiện ảnh hưởng.','Chọn mục tiêu, hoạt động, hình thức và học liệu.','Theo dõi, đánh giá lại và điều chỉnh hỗ trợ.','Duy trì thực hành, quay lại chu trình đánh giá.'][i]}</div></div>`).join('')}</div><div class="panel"><h2>Trạng thái hệ thống</h2><p>Đã có <b>${db.students.length}</b> hồ sơ học sinh và <b>${db.classes.length}</b> lớp.</p><p>Đã ghi nhận <b>${db.assess.length}</b> lượt đánh giá.</p><div class="notice">Dữ liệu lưu trong trình duyệt. Không tự đồng bộ giữa các máy. Hãy sao lưu thường xuyên.</div><button class="btn primary" onclick="go('students')">Quản lý hồ sơ</button></div></div><div class="panel"><h2>Sáu nhóm giải pháp</h2><div class="grid six">${solutions.map(x=>`<div class="tile"><b>${x[0]}</b><span class="small">${x[1]}</span></div>`).join('')}</div></div>`}
