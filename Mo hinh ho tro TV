function assessmentPage(){return `<div class="panel"><h2>Tạo lượt đánh giá năng lực</h2><div class="formgrid"><div class="field"><label>Học sinh</label><select id="aStudent"><option value="">Chọn học sinh</option>${db.students.map(s=>`<option value="${s.id}">${esc(s.name)} · ${esc(clsName(s.classId))}</option>`).join('')}</select></div><div class="field"><label>Thời điểm đánh giá</label><input id="aDate" type="date" value="${new Date().toISOString().slice(0,10)}"></div><div class="field"><label>Đợt đánh giá</label><select id="aRound"><option>Đánh giá ban đầu</option><option>Đánh giá giữa kỳ</option><option>Đánh giá sau hỗ trợ</option><option>Đánh giá định kỳ</option></select></div><div class="field"><label>Ghi chú quan sát</label><input id="aNote" placeholder="Biểu hiện, điều kiện đánh giá..."></div></div><div class="notice">Mỗi kỹ năng có 5 tiêu chí để giáo viên ghi nhận theo thang 1–5. Tên tiêu chí dưới đây là ô nhập linh hoạt; hãy đối chiếu và cập nhật đúng bộ phiếu/khung năng lực chính thức của từng khối lớp trước khi đánh giá.</div><div class="skilltabs">${skills.map(x=>`<button class="${skill===x?'active':''}" onclick="skill='${x}';render()">${x}</button>`).join('')}</div><div id="criteriaBox">${[1,2,3,4,5].map(i=>`<div class="scoregrid"><div><b>Tiêu chí ${i}</b><div class="small muted">Mô tả/biểu hiện cần quan sát</div><input style="width:100%;margin-top:5px;padding:7px;border:1px solid var(--line);border-radius:7px" id="desc${i}" placeholder="Nhập tiêu chí theo khung lớp..." /></div><select id="score${i}">${levels.map((l,n)=>`<option value="${n}">${l||'Chưa chấm'}</option>`).join('')}</select></div>`).join('')}</div><div class="actions" style="margin-top:15px"><button class="btn primary" onclick="saveAssessment()">Lưu đánh giá kỹ năng ${skill}</button></div></div><div class="panel"><h2>Lịch sử đánh giá</h2>${assessmentTable()}</div>`}
