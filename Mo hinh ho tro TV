function filterS(){let q=document.getElementById('sq').value.toLowerCase(),g=document.getElementById('sg').value;document.getElementById('stTable').innerHTML=studentTable(db.students.filter(s=>s.name.toLowerCase().includes(q)&&(!g||String(db.classes.find(c=>c.id===s.classId)?.grade)===g)))}
